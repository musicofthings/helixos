{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixos.dev/schemas/eln/experiment.schema.json",
  "title": "Experiment",
  "type": "object",
  "required": ["id", "organization_id", "project_id", "name", "description", "head_version_id", "version_count", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string" },
    "organization_id": { "type": "string" },
    "project_id": { "type": ["string", "null"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "head_version_id": { "type": ["string", "null"] },
    "version_count": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
