# Browser dev: the web app calls /api on its own origin and Next proxies it to
# the API (npm run dev:browser starts the API on :8000).
# HELIX_API_PROXY_TARGET=http://127.0.0.1:8000

# Only set to bypass the proxy and call an API origin directly; that origin
# must then be listed in the API's ALLOWED_ORIGINS.
# NEXT_PUBLIC_API_URL=

# Dev convenience. NEXT_PUBLIC_* values are compiled into the browser bundle,
# so never put a real credential here. Production builds do not default to the
# demo token; a staging build must set it explicitly.
NEXT_PUBLIC_API_TOKEN=org-demo-token
