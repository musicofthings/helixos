# HelixOS local development environment
# Copy to apps/web/.env.local for browser dev (setup-dev.sh does this automatically)

# Web -> API (browser dev stack on port 8000). The browser calls /api on the
# web origin and Next proxies it to the API (apps/web/next.config.ts).
HELIX_API_PROXY_TARGET=http://127.0.0.1:8000
# Leave unset to use the proxy; set only to call an API origin directly (that
# origin's page must then be listed in ALLOWED_ORIGINS).
# NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_TOKEN=org-demo-token

# API sidecar / standalone API
HELIX_DATABASE_URL=sqlite:///<repo-root>/.data/helixos-dev.db
HELIX_AI_PROVIDER=stub
# HELIX_AI_PROVIDER=openai
# HELIX_OPENAI_API_KEY=sk-...

# Deployment posture: development (default) | staging | production.
# Hosted environments refuse to start on unsafe config; see docs/DEPLOYMENT.md.
# HELIX_ENV=production
# Comma-separated web origins allowed by CORS (required when hosted; no "*").
# Development additionally allows any http://localhost / 127.0.0.1 port.
# ALLOWED_ORIGINS=https://app.example.com
# Sign-in via any OpenID Connect provider (required in production).
# HELIX_OIDC_ISSUER=https://idp.example.com/
# HELIX_OIDC_AUDIENCE=helixos-api
# HELIX_OIDC_JWKS_URL=            # optional; discovered from the issuer by default
# Web build (public values): NEXT_PUBLIC_OIDC_AUTHORITY, NEXT_PUBLIC_OIDC_CLIENT_ID,
#   optional NEXT_PUBLIC_OIDC_AUDIENCE / _SCOPE / _TOKEN_TYPE. See docs/modules/auth.md.
# Staging only: accept the documented demo tokens instead of / alongside OIDC.
# HELIX_ENABLE_DEMO_TOKENS=1
# 1/0 override for /docs and /openapi.json (default: on except in production).
# HELIX_ENABLE_DOCS=0
# Behind a reverse proxy, trust its X-Forwarded-* headers ("*" on Cloud Run).
# FORWARDED_ALLOW_IPS=*

# Desktop
HELIX_DISABLE_AUTOUPDATE=1
# HELIX_PYTHON=/path/to/python3

# Optional Postgres (docker compose up -d postgres)
# HELIX_DATABASE_URL=postgresql+psycopg://helixos:helixos@127.0.0.1:5432/helixos
